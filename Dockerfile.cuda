# syntax=docker/dockerfile:1.7
# ==============================================================================
# orazaka-worker-media — the CUDA image (ADR-077). ghcr.io/krizaka/orazaka-worker-media:cuda-<sha>
#
# One image, two processes, started by the GPU host (krizaka/orazaka infra/gpu/compose.yml):
#   * the media worker (python -m app.consumer): Wan 2.x 9:16 video on job.video.*, ffmpeg composition
#     on job.compose.*, through the same AMQP protocol as on the Mac;
#   * sd-server (stable-diffusion.cpp, built here for CUDA): FLUX.2 [klein] 4B images, the same backend
#     and the same recipe as the Mac's Metal build (ADR-075).
# Weights are never baked in: they live on the host's models volume (/models), fetched once by
# `python -m app.fetch_models big|small`.
# ==============================================================================
# The images below are pinned by digest (OpenSSF Scorecard, Pinned-Dependencies): changing CUDA_VERSION means changing both digests
# (`docker buildx imagetools inspect nvidia/cuda:<version>-<flavour>-ubuntu24.04`).
ARG CUDA_VERSION=12.8.1

# --- stable-diffusion.cpp, CUDA ------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04@sha256:520292dbb4f755fd360766059e62956e9379485d9e073bbd2f6e3c20c270ed66 AS sdcpp
RUN apt-get update \
 && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# The commit the Mac's CLI builds (master-647, 2026-05-24): the same server, the same flags.
ARG SDCPP_REF=a397e03488cc27e1a42da646b82dfce9f50741c0
RUN git clone https://github.com/leejet/stable-diffusion.cpp /src \
 && git -C /src checkout "${SDCPP_REF}" \
 && git -C /src submodule update --init --recursive
# Ada (RTX 4000/6000 Ada, L40S) is sm_89, Hopper (H100/H200) sm_90: the GPU droplets DigitalOcean rents.
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DSD_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="89;90" -DSD_SERVER_BUILD_FRONTEND=OFF \
 && cmake --build /build --config Release -j"$(nproc)" --target sd-server \
 && cp "$(find /build -type f -name sd-server -perm -u+x | head -1)" /sd-server

# --- the worker ----------------------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04@sha256:ebef3c171eeef0298e4eb2e4be843105edf3b8b0ac45e0b43acee358e8046867
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
RUN python3 -m venv /opt/venv \
 && pip install --no-cache-dir --only-binary :all: pip==26.1.1 \
 && pip install --no-cache-dir --only-binary :all: torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
COPY requirements-cuda.txt /tmp/requirements-cuda.txt
RUN pip install --no-cache-dir --only-binary :all: -r /tmp/requirements-cuda.txt
COPY --from=sdcpp /sd-server /usr/local/bin/sd-server

WORKDIR /app
COPY app ./app
COPY worker.yaml models.yaml ./

# The worker runs unprivileged; /models and the upload scratch are mounted by the host.
RUN useradd --uid 10001 --create-home orazaka && mkdir -p /models /var/lib/orazaka && chown -R orazaka /models /var/lib/orazaka
USER orazaka
ENV PYTHONUNBUFFERED=1 \
    MEDIA_MODELS_DIR=/models \
    HF_HOME=/models/hf \
    HF_HUB_CACHE=/models/hf/hub \
    HF_HUB_DISABLE_TELEMETRY=1 \
    UPLOAD_DIR=/var/lib/orazaka/uploads \
    MEDIA_WORKER_PORT=8188
EXPOSE 8188 8086
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD curl -fsS http://127.0.0.1:8188/ || exit 1
CMD ["python", "-u", "-m", "app.consumer"]
